# eVal sandbox service: starts one isolated container per terminal session (see docs/SANDBOX.md).
# It talks to the Docker Engine, and is the only eVal component that does. It gets no database URL, no
# repository credentials and no app secrets: only EVAL_SANDBOX_SECRET, to check requests signed by eVal.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN pip install --no-cache-dir "aiohttp>=3.9,<4"
COPY eval_sandbox ./eval_sandbox

EXPOSE 8100
CMD ["python", "-m", "eval_sandbox"]

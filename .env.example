# eVal configuration. Copy to .env and fill in. Never commit .env.

# development | production
EVAL_ENV=development

# >= 32 random chars:  python -c "import secrets; print(secrets.token_urlsafe(48))"
EVAL_SECRET_KEY=

# Comma-separated Fernet keys; first encrypts, all decrypt (rotation).
#   python -m eval_app.security.crypto
EVAL_ENCRYPTION_KEYS=

# Used by docker-compose for the bundled Postgres.
POSTGRES_PASSWORD=

# When running the app from a virtualenv against the compose services:
DATABASE_URL=postgresql+psycopg://eval:CHANGE_ME@127.0.0.1:55450/eval
REDIS_URL=redis://127.0.0.1:56390/0
# Separate database for the PostgreSQL integration tests (created by scripts/create_test_db.sql).
TEST_DATABASE_URL=postgresql+psycopg://eval:CHANGE_ME@127.0.0.1:55450/eval_test

EVAL_DATA_DIR=./var
EVAL_MAX_UPLOAD_MB=50
EVAL_ALLOW_REGISTRATION=true
# Organizations one user may create (each gets its own concurrent-audit allowance on the shared workers).
EVAL_MAX_ORGS_PER_USER=5
# Set to false only for local HTTP development.
EVAL_SECURE_COOKIES=true
# Number of trusted reverse proxies in front of the app (honours X-Forwarded-For/-Proto). 0 = none.
# Set this behind a TLS proxy, or every client shares the proxy's IP for rate limiting.
EVAL_PROXY_FIX_HOPS=0
# Login attempts per 5 minutes: per IP+email, and per IP across all emails.
EVAL_LOGIN_RATE_LIMIT=10
EVAL_LOGIN_IP_RATE_LIMIT=50
# Longest an accepted risk may last before the finding reopens for review.
EVAL_ACCEPTED_RISK_MAX_DAYS=365

# Repository handling limits
EVAL_WORKSPACE_MAX_FILES=20000
EVAL_WORKSPACE_MAX_TOTAL_MB=500
EVAL_WORKSPACE_MAX_FILE_MB=20
EVAL_ANALYZER_TIMEOUT_SECONDS=300
EVAL_GIT_ALLOWED_HOSTS=github.com

# GitHub (Enterprise users: point at https://HOST/api/v3 and add HOST to EVAL_GIT_ALLOWED_HOSTS;
# repositories are cloned from the same host as the API, so tokens never leave their instance)
GITHUB_API_URL=https://api.github.com
# "Connect GitHub" button: create an OAuth App (GitHub → Settings → Developer settings → OAuth Apps) with
# Authorization callback URL https://YOUR-HOST/integrations/github/callback (http://127.0.0.1:5000/... locally).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Social sign-in ("Continue with GitHub / Google / LinkedIn"). Each button appears once its pair is set.
# Callback URLs: https://YOUR-HOST/login/github/callback, /login/google/callback, /login/linkedin/callback
# GitHub: leave AUTH_GITHUB_* empty to reuse the GITHUB_OAUTH_* app above; then set that app's callback URL to
#   the site root (e.g. http://127.0.0.1:5000/) so both /integrations/... and /login/... callbacks are accepted.
# Google: Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web application).
# LinkedIn: developer app with the "Sign In with LinkedIn using OpenID Connect" product.
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_LINKEDIN_CLIENT_ID=
AUTH_LINKEDIN_CLIENT_SECRET=

# GitHub App (automatic PR audits, check runs, re-audit on push). See docs/CI.md section C.
#   Webhook URL: https://YOUR-HOST/webhooks/github   Setup URL: https://YOUR-HOST/integrations/github/app/setup
#   Enable "Request user authorization (OAuth) during installation" so eVal can verify who installed it.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM private key (literal \n escapes accepted), or a path in GITHUB_APP_PRIVATE_KEY_FILE.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Public base URL of this server; the worker uses it for links in check runs and notifications.
EVAL_PUBLIC_URL=

# Scratch dir for checkouts (wiped per audit; tmpfs in the worker container). Default: $EVAL_DATA_DIR/work
EVAL_WORK_DIR=

# Analyzer configuration
# Dependency vulnerability lookup via OSV.dev (sends package names + versions only). 0 to disable.
EVAL_OSV_ENABLED=1
# Check that declared dependencies exist on PyPI/npm and are not brand new (sends package names only). 0 to disable.
EVAL_REGISTRY_CHECK_ENABLED=1
# Semgrep rules: registry pack (needs network) or a local rules directory for air-gapped installs.
EVAL_SEMGREP_CONFIG=p/default
# Persistent Trivy vulnerability DB cache (avoid re-downloading per audit).
EVAL_TRIVY_CACHE_DIR=
# Extra directories searched for analyzer binaries (os.pathsep-separated), e.g. ./.tools/node_modules/.bin
EVAL_TOOL_PATH=

# AI: allow-list of OpenAI-compatible endpoints tenants may select (prevents SSRF), e.g. http://ollama:11434/v1
EVAL_AI_ALLOWED_BASE_URLS=
EVAL_AI_TIMEOUT_SECONDS=120

# Run Celery tasks inline (no worker). Development convenience only.
CELERY_TASK_ALWAYS_EAGER=false

# AI provider keys are NOT configured here: they are stored per organization, encrypted, via
# Settings → Integrations in the UI.
